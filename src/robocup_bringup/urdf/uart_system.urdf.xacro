<?xml version="1.0"?>
<robot name="robocup_uart" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="serial_port" default="/dev/ttyACM0"/>
  <xacro:arg name="can_preview_period_ms" default="200"/>
  <xacro:macro name="wheel_joint" params="index">
    <link name="wheel_${index}"/>
    <joint name="wheel_${index}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="wheel_${index}"/>
      <axis xyz="1 0 0"/>
    </joint>
  </xacro:macro>
  <xacro:macro name="wheel_interfaces" params="index">
    <joint name="wheel_${index}_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <link name="base_link"/>
  <xacro:wheel_joint index="0"/>
  <xacro:wheel_joint index="1"/>
  <xacro:wheel_joint index="2"/>

  <ros2_control name="UartWheelSystem" type="system">
    <hardware>
      <plugin>robocup_uart_hardware/UartSystem</plugin>
      <param name="serial_port">$(arg serial_port)</param>
      <param name="command_period_ms">20</param>
      <param name="response_timeout_ms">100</param>
      <param name="can_preview_period_ms">$(arg can_preview_period_ms)</param>
      <param name="max_wheel_speed_rad_s">8.37</param>
      <param name="disarm_joy_button">1</param>
    </hardware>
    <xacro:wheel_interfaces index="0"/>
    <xacro:wheel_interfaces index="1"/>
    <xacro:wheel_interfaces index="2"/>
  </ros2_control>
</robot>
